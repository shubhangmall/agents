# Example environment variables for the Career Chatbot project
# Copy this file to `.env` and add your real values.

# Gemini API key (Google AI Studio). Chat uses gemini-2.0-flash via the
# OpenAI-compatible endpoint. Embeddings are local MiniLM.
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional: tokens used by the app for notifications or tools
PUSHOVER_TOKEN=your_pushover_token_here
PUSHOVER_USER=your_pushover_user_key_here
SENDGRID_API_KEY=your_sendgrid_api_key_here
