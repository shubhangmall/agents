# Example environment for Deep Research agent
# Copy to `.env` and populate with your own keys.

# Initial hosted configuration: OpenRouter's free route.
LLM_PROVIDER=openrouter
LLM_MODEL=openrouter/free
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional hosted alternative.
GROQ_API_KEY=your_groq_api_key_here

# Optional local alternative. Localhost is not reachable from a cloud deployment.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Tavily Basic search is the initial search provider.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here
SEARCH_MAX_RESULTS=5
SEARCH_EVIDENCE_MAX_CHARS=12000

# SendGrid key for the email agent (if used)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=sender@example.com
SENDGRID_TO_EMAIL=recipient@example.com

# Optional; email is disabled unless explicitly set to true.
SEND_RESEARCH_EMAIL=false
