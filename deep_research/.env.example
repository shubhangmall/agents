# Example environment for Deep Research agent
# Copy to `.env` and populate with your own keys.

# Gemini key for planning, grounded search, and report writing
GEMINI_API_KEY=your_gemini_api_key_here

# SendGrid key for the email agent (if used)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Pushover credentials for mobile notifications
PUSHOVER_TOKEN=your_pushover_token_here
PUSHOVER_USER=your_pushover_user_key_here

# Optional; email is disabled unless explicitly set to true.
SEND_RESEARCH_EMAIL=false
